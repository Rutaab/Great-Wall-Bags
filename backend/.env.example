# SMTP settings for real verification email delivery.
# Gmail example (with an App Password — NOT your normal Gmail password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your.email@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx
#   SMTP_FROM=HoBags Kinetic Marketplace <your.email@gmail.com>
#
# Leave SMTP_HOST empty to keep dev mode (code returned in API response).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HoBags Kinetic Marketplace <noreply@hobags.com>